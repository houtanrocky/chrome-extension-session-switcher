{
  // WXT generates `.wxt/tsconfig.json` on `wxt prepare` (runs via postinstall).
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": ["./*"]
    }
  }
}
